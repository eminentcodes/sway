# Copy to .env.local (repo root) and fill in. NEVER commit .env.local or any key file.
# Both the Next app and the helper scripts (npm run discover/smoke/trade:live) read this
# root .env.local; the scripts also fall back to _template/.env if present (non-overriding).

# ── Required for signing (bets, cash-outs, redeems via the server key path) ──
# A funded Shannon testnet key. Signs the server-side "Path B" transactions.
# Get testnet tUSDC (collateral) + STT (gas) from the SomniaHacks dev group (faucet topic):
#   https://t.me/+XHq0F0JXMyhmMzM0
# Read-only flows (discovery, rounds, leaderboard) work without a funded key.
PRIVATE_KEY=0x...

# ── Somnia Shannon testnet (chain 50312). Defaults below usually work. ──
RPC_URL=https://dream-rpc.somnia.network
WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws

# Indexer (GraphQL) — the SDK requires one at construction. Every read/write here is
# on-chain, so the value is effectively unused, but must be present. Public endpoint pre-filled.
INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# ── Market fee (OPTIONAL, OFF by default) ──────────────────────────────────
# Sway can take a small cut on each ENTRY, routed on-chain through the protocol's
# native builder-fee rail to a treasury address. Leave BUILDER_ADDRESS unset to keep
# the fee OFF (the demo runs fee-free). These are NEXT_PUBLIC_ because a fee-receiving
# address is public and the fee must apply identically in the browser and on the server.
# NEXT_PUBLIC_SWAY_BUILDER_ADDRESS=0xYourTreasury
# NEXT_PUBLIC_SWAY_BUILDER_FEE_BPS_TIMES_1K=100000   # 100000 = 100 bps = 1%
# NEXT_PUBLIC_SWAY_BUILDER_FEE_ENABLED=true
